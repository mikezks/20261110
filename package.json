{
  "name": "angular-essentials",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve flight42",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test flight42",
    "test:ci": "ng test flight42 --browsers=chromiumHeadless --watch=false",
    "start:web-essentials": "vite apps/web-essentials --host 127.0.0.1 --port 4300 --strictPort",
    "typecheck:web-essentials": "tsc -p apps/web-essentials/tsconfig.json"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular-architects/paper-design": "^2.0.1",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@vitest/browser-playwright": "^5.1.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vite": "^8.3.7"
  }
}
